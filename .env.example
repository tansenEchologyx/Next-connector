# Copy to .env and fill in values:
#   cp .env.example .env

# --- Database (Docker local — port 5433 avoids conflict with other Postgres installs) ---
DATABASE_URL="postgresql://next_connector:next_connector@localhost:5433/next_connector"

# --- Shopify (set automatically by `shopify app dev` in .env) ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=read_products,read_inventory,write_orders,read_orders,read_customers,read_fulfillments,read_locations
# SHOPIFY_APP_URL=
# WORKER_SHOP=your-store.myshopify.com
# WORKER_POLL_INTERVAL_MS=10000
# Inventory delta interval is configured in Settings (minutes), not here.
# Seconds after KornitX order received before shipping status is sent (1200 = 20 min)
FULFILLMENT_DELAY_SECONDS=1200

# --- KornitX outbound (mock Beeceptor for local dev; swap for production URLs) ---
KORNITX_REF_ID=mock-ref
KORNITX_API_KEY=mock-key
KORNITX_STOCK_URL=https://next-connector.free.beeceptor.com/inventory
KORNITX_SHIPPING_URL=https://next-connector.free.beeceptor.com/shipment

# Production (uncomment and remove/comment mock URLs above):
# KORNITX_REF_ID=your-kornitx-ref-id
# KORNITX_API_KEY=your-kornitx-api-key
# KORNITX_STOCK_URL=https://api-sl-2-2.custom-gateway.net/stock/availability
# KORNITX_SHIPPING_URL=
# KORNITX_ORDER_STATUS_BASE_URL=https://api-sl-2-2.custom-gateway.net

# --- Inbound webhook auth (KornitX POST to our app) ---
# Basic auth (most common for UAT):
# KORNITX_WEBHOOK_BASIC_USER=
# KORNITX_WEBHOOK_BASIC_PASSWORD=
# OAuth2 bearer token (alternative):
# KORNITX_WEBHOOK_OAUTH_TOKEN=
